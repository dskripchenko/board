{
  "name": "@dskripchenko/board",
  "version": "0.1.1",
  "description": "An infinite whiteboard: shapes, stickies, frames, titles, connectors and emoji — a zero-dependency TypeScript core (model, geometry, undoable operations, real-time sync) and Vue components on @dskripchenko/ui",
  "keywords": [
    "whiteboard",
    "board",
    "canvas",
    "sticky-notes",
    "diagram-editor",
    "collaboration",
    "real-time",
    "svg",
    "vue",
    "zero-dependency"
  ],
  "homepage": "https://github.com/dskripchenko/board#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskripchenko/board.git"
  },
  "bugs": {
    "url": "https://github.com/dskripchenko/board/issues"
  },
  "license": "MIT",
  "author": "Denis Skripchenko (https://github.com/dskripchenko)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json",
    "dev": "vite --config playground/vite.config.ts",
    "prepublishOnly": "pnpm build",
    "check:browser": "node scripts/browser-check.mjs",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "@dskripchenko/ui": "^1.17.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@dskripchenko/ui": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@dskripchenko/ui": "^1.17.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
